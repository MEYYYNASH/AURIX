<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_outer_shadow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shadow_cyan_neon"
    android:layoutDirection="locale"
    android:paddingBottom="5dp">

    <FrameLayout
        android:id="@+id/widget_music_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_clip_26dp"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_music_bg_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- Smoked tint rgba(6,8,18,.62) -->
        <FrameLayout
            android:id="@+id/widget_music_bg_tint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#9E060812" />

        <!-- Purple radial sheen in top right corner -->
        <FrameLayout
            android:id="@+id/widget_music_sheen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_sheen_neon_top_right" />

        <!-- 1dp purple edge rgba(160,107,255,.55) -->
        <FrameLayout
            android:id="@+id/widget_music_card_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_edge_neon_26dp" />

        <LinearLayout
            android:id="@+id/widget_music_empty_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="18dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_music_empty_orbi"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_orbi" />

            <ImageView
                android:id="@+id/widget_music_empty_bitmap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_music_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_tap_to_play"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Style 3 Smoked Neon Content: 18dp padding -->
        <LinearLayout
            android:id="@+id/widget_music_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Top Row: Title 26sp semibold + Artist 14sp 60% on left, 62dp art tilted 6 deg top right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/widget_music_meta_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/widget_music_title_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_music_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="true"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/widget_music_artist_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_music_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:includeFontPadding="true"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_music_album_art"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:contentDescription="@string/widget_cd_album_art"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <!-- 22-pill segmented progress (gradient when filled) -->
            <ImageView
                android:id="@+id/widget_music_segmented_progress"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <!-- Bottom row of plain icons (prev, like, 30dp play, next) with >=44dp tap targets, no backgrounds -->
            <LinearLayout
                android:id="@+id/widget_music_controls_row"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="44dp"
                    android:minHeight="44dp">

                    <ImageView
                        android:id="@+id/widget_btn_prev_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/widget_cd_prev"
                        android:src="@drawable/ic_widget_prev" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_btn_like"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="44dp"
                    android:minHeight="44dp">

                    <ImageView
                        android:id="@+id/widget_btn_like_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/widget_cd_like"
                        android:src="@drawable/ic_widget_heart_outline" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_btn_play_pause"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="44dp"
                    android:minHeight="44dp">

                    <ImageView
                        android:id="@+id/widget_btn_play_pause_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/widget_cd_play_pause"
                        android:src="@drawable/ic_widget_play" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_btn_next"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="44dp"
                    android:minHeight="44dp">

                    <ImageView
                        android:id="@+id/widget_btn_next_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/widget_cd_next"
                        android:src="@drawable/ic_widget_next" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
