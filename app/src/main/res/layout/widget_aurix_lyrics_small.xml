<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lyrics_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_clip"
    android:clipToOutline="true">

    <!-- Pre-rendered Canvas composite bitmap (small 420x420) -->
    <ImageView
        android:id="@+id/widget_lyrics_bg_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/widget_lyrics_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_lyrics_empty_orbi"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_orbi" />

        <TextView
            android:id="@+id/widget_lyrics_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="@string/widget_open_aurix"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Active Small Content -->
    <LinearLayout
        android:id="@+id/widget_lyrics_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_lyrics_tag_container"
                android:layout_width="wrap_content"
                android:layout_height="20dp">

                <ImageView
                    android:id="@+id/widget_lyrics_tag_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="7dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_widget_lyrics_wave" />

                    <TextView
                        android:id="@+id/widget_lyrics_tag_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="@string/widget_lyrics_tag"
                        android:textColor="#E8F9FF"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_lyrics_brand_orbi"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:alpha="0.82"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_orbi" />
        </LinearLayout>

        <!-- No-lyrics song state: title and artist only -->
        <LinearLayout
            android:id="@+id/widget_lyrics_no_lyrics_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_lyrics_no_lyrics_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#66000000"
                android:shadowDy="1.5"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_lyrics_no_lyrics_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B8FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Lyrics Stage -->
        <LinearLayout
            android:id="@+id/widget_lyrics_stage_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_lyrics_frame_spacer"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_lyrics_accent_bar"
                android:layout_width="2.5dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_lyric_accent_bar"
                android:contentDescription="@null" />

            <ViewFlipper
                android:id="@+id/widget_lyrics_flipper"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:animateFirstView="false"
                android:autoStart="false"
                android:inAnimation="@anim/widget_lyric_slide_in"
                android:outAnimation="@anim/widget_lyric_slide_out">

                <FrameLayout
                    android:id="@+id/widget_lyrics_slot_a"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/widget_lyrics_khmer_bitmap_a"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/widget_lyrics_text_container_a"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_lyrics_current_line_a"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="true"
                            android:lineSpacingExtra="1.5dp"
                            android:maxLines="2"
                            android:shadowColor="#66000000"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:textColor="#FFFFFF"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_lyrics_next_line_a"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#A8FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_lyrics_slot_b"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/widget_lyrics_khmer_bitmap_b"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/widget_lyrics_text_container_b"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_lyrics_current_line_b"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="true"
                            android:lineSpacingExtra="1.5dp"
                            android:maxLines="2"
                            android:shadowColor="#66000000"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:textColor="#FFFFFF"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_lyrics_next_line_b"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#A8FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>
            </ViewFlipper>
        </LinearLayout>

        <!-- Compact Footer -->
        <LinearLayout
            android:id="@+id/widget_lyrics_footer_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_lyrics_mini_art"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_lyrics_song_footer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#B8FFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_lyrics_card_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_border_dark"
        android:contentDescription="@null" />
</FrameLayout>
