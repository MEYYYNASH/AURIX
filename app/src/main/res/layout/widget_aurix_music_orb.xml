<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_outer_shadow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shadow_soft"
    android:layoutDirection="locale"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/widget_music_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_clip_44dp"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_music_bg_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <FrameLayout
            android:id="@+id/widget_music_bg_tint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#57121628" />

        <FrameLayout
            android:id="@+id/widget_music_sheen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_sheen_top_left" />

        <FrameLayout
            android:id="@+id/widget_music_card_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_edge_orb_44dp" />

        <LinearLayout
            android:id="@+id/widget_music_empty_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="18dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_music_empty_orbi"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_orbi" />

            <ImageView
                android:id="@+id/widget_music_empty_bitmap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_music_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_tap_to_play"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Style 2 Orb Content: 44dp corners, 18dp padding -->
        <LinearLayout
            android:id="@+id/widget_music_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <!-- 88dp circular disc with 34dp hole & white 30% ring -->
            <ImageView
                android:id="@+id/widget_music_album_art"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@string/widget_cd_album_art"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:id="@+id/widget_music_meta_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_music_title_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitStart"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_music_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_music_artist_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitStart"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_music_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13.5sp" />

                <!-- 4dp progress line -->
                <ProgressBar
                    android:id="@+id/widget_music_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_orb" />

                <!-- Round 46dp glass bubble buttons + 58dp white play circle -->
                <LinearLayout
                    android:id="@+id/widget_music_controls_row"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/widget_btn_prev"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/widget_orb_bubble_btn"
                        android:minWidth="46dp"
                        android:minHeight="46dp">

                        <ImageView
                            android:id="@+id/widget_btn_prev_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/widget_cd_prev"
                            android:src="@drawable/ic_widget_prev" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <FrameLayout
                        android:id="@+id/widget_btn_play_pause"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/widget_circle_white"
                        android:minWidth="58dp"
                        android:minHeight="58dp">

                        <ImageView
                            android:id="@+id/widget_btn_play_pause_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/widget_cd_play_pause"
                            android:src="@drawable/ic_widget_play" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <FrameLayout
                        android:id="@+id/widget_btn_next"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/widget_orb_bubble_btn"
                        android:minWidth="46dp"
                        android:minHeight="46dp">

                        <ImageView
                            android:id="@+id/widget_btn_next_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/widget_cd_next"
                            android:src="@drawable/ic_widget_next" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/widget_btn_like"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/widget_orb_bubble_btn"
                        android:minWidth="46dp"
                        android:minHeight="46dp">

                        <ImageView
                            android:id="@+id/widget_btn_like_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/widget_cd_like"
                            android:src="@drawable/ic_widget_heart_outline" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
