<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_outer_shadow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">

    <FrameLayout
        android:id="@+id/widget_music_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_clip_28dp_paper"
        android:clipToOutline="true">

        <!-- Layer 1: Cream paper (#EFE6D6) + top-right highlight + horizontal fibers + 1px inner ring -->
        <ImageView
            android:id="@+id/widget_music_bg_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY" />

        <!-- Layer 2: Half-visible 164dp vinyl disc on left edge (-82dp offset), vertically centered BEHIND text -->
        <ImageView
            android:id="@+id/widget_music_album_art"
            android:layout_width="82dp"
            android:layout_height="164dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/widget_cd_album_art"
            android:scaleType="fitStart" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/widget_music_empty_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="98dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_music_empty_bitmap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_music_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_tap_to_play"
                android:textColor="#2A2118"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Vinyl Player Content: left padding 98dp, top 18dp, right 16dp -->
        <LinearLayout
            android:id="@+id/widget_music_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="98dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/widget_music_meta_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_music_title_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitStart"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_music_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#2A2118"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_music_artist_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitStart"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_music_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#A62A2118"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Progress bar 5dp tall, 14dp below artist -->
            <ProgressBar
                android:id="@+id/widget_music_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="14dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_vinyl" />

            <!-- Elapsed & Total times (11sp tabular numbers, 55% opacity) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_music_time_elapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:text="0:00"
                    android:textColor="#8C2A2118"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_music_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="0:00"
                    android:textColor="#8C2A2118"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Controls row: prev, like, 52dp #2A2118 circle play/pause, next -->
            <LinearLayout
                android:id="@+id/widget_music_controls_row"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:minWidth="44dp"
                    android:minHeight="44dp">

                    <ImageView
                        android:id="@+id/widget_btn_prev_icon"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/widget_cd_prev"
                        android:src="@drawable/ic_widget_prev" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_btn_like"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:minWidth="44dp"
                    android:minHeight="44dp">

                    <ImageView
                        android:id="@+id/widget_btn_like_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/widget_cd_like"
                        android:src="@drawable/ic_widget_heart_outline" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_btn_play_pause"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/widget_circle_ink_brown"
                    android:minWidth="48dp"
                    android:minHeight="48dp">

                    <ImageView
                        android:id="@+id/widget_btn_play_pause_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/widget_cd_play_pause"
                        android:src="@drawable/ic_widget_play" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_btn_next"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:minWidth="44dp"
                    android:minHeight="44dp">

                    <ImageView
                        android:id="@+id/widget_btn_next_icon"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/widget_cd_next"
                        android:src="@drawable/ic_widget_next" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_border_28dp_paper_ring" />
    </FrameLayout>
</FrameLayout>
