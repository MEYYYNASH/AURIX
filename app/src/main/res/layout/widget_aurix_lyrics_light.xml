<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lyrics_outer_shadow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shadow_soft"
    android:layoutDirection="locale"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/widget_lyrics_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_clip_32dp"
        android:clipToOutline="true">

        <!-- Saturated light blurred cover -->
        <ImageView
            android:id="@+id/widget_lyrics_bg_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- White 55%+ frosted tint -->
        <FrameLayout
            android:id="@+id/widget_lyrics_bg_tint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#8CFFFFFF" />

        <FrameLayout
            android:id="@+id/widget_lyrics_sheen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_sheen_top_left" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/widget_lyrics_empty_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_lyrics_empty_orbi"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_orbi" />

            <ImageView
                android:id="@+id/widget_lyrics_empty_bitmap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_lyrics_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_tap_to_play"
                android:textColor="#14172A"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Style 4 Light Frost Lyrics: no card padding; left 38% cover fade, right 62% accent Lyrics tag + 19sp dark #14172A + 13sp 50% next -->
        <LinearLayout
            android:id="@+id/widget_lyrics_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="100">

            <ImageView
                android:id="@+id/widget_lyrics_header_art"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="38"
                android:contentDescription="@string/widget_cd_album_art"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="62"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <!-- Top Row: Accent Lyrics tag chip + Orbi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/widget_lyrics_chip_container"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="@drawable/widget_light_chip_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="9dp">

                        <ImageView
                            android:id="@+id/widget_lyrics_eq_bitmap"
                            android:layout_width="14dp"
                            android:layout_height="11dp"
                            android:layout_marginEnd="5dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/widget_lyrics_chip_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/widget_lyrics_tag"
                            android:textColor="#3B46E0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/widget_lyrics_brand_orbi"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:alpha="0.88"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_widget_orbi" />
                </LinearLayout>

                <!-- No-lyrics fallback -->
                <LinearLayout
                    android:id="@+id/widget_lyrics_no_lyrics_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/widget_lyrics_no_lyrics_label_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyrics_no_lyrics_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_no_lyrics_for_song"
                        android:textColor="#8014172A"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/widget_lyrics_no_lyrics_title_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyrics_no_lyrics_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#14172A"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Synced Stage -->
                <LinearLayout
                    android:id="@+id/widget_lyrics_stage_row"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <ViewFlipper
                        android:id="@+id/widget_lyrics_flipper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateFirstView="false"
                        android:autoStart="false"
                        android:inAnimation="@anim/widget_lyric_slide_in"
                        android:outAnimation="@anim/widget_lyric_slide_out">

                        <!-- Slot A -->
                        <FrameLayout
                            android:id="@+id/widget_lyrics_slot_a"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical">

                            <ImageView
                                android:id="@+id/widget_lyrics_khmer_bitmap_a"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:adjustViewBounds="true"
                                android:contentDescription="@null"
                                android:scaleType="fitStart"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/widget_lyrics_text_container_a"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/widget_lyrics_current_line_a"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:includeFontPadding="true"
                                    android:lineSpacingExtra="2dp"
                                    android:maxLines="2"
                                    android:textColor="#14172A"
                                    android:textSize="19sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/widget_lyrics_next_line_a"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Slot B -->
                        <FrameLayout
                            android:id="@+id/widget_lyrics_slot_b"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical">

                            <ImageView
                                android:id="@+id/widget_lyrics_khmer_bitmap_b"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:adjustViewBounds="true"
                                android:contentDescription="@null"
                                android:scaleType="fitStart"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/widget_lyrics_text_container_b"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/widget_lyrics_current_line_b"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:includeFontPadding="true"
                                    android:lineSpacingExtra="2dp"
                                    android:maxLines="2"
                                    android:textColor="#14172A"
                                    android:textSize="19sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/widget_lyrics_next_line_b"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </FrameLayout>
                    </ViewFlipper>

                    <!-- Static Next Line OUTSIDE ViewFlipper (13sp, 50% #14172A) -->
                    <FrameLayout
                        android:id="@+id/widget_lyrics_next_static_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <ImageView
                            android:id="@+id/widget_lyrics_next_khmer_bitmap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:scaleType="fitStart"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/widget_lyrics_next_line_static"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="true"
                            android:maxLines="1"
                            android:textColor="#8014172A"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Footer Title · Artist -->
                <LinearLayout
                    android:id="@+id/widget_lyrics_footer_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_lyrics_footer_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyrics_song_footer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="true"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#A614172A"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_lyrics_card_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_edge_light_32dp" />
    </FrameLayout>
</FrameLayout>
