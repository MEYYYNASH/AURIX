<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lyrics_outer_shadow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shadow_soft"
    android:layoutDirection="locale"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/widget_lyrics_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_clip_30dp"
        android:clipToOutline="true">

        <!-- Layer 1: Cover art pre-blurred ~26px, sat +50%, scaled 1.2x -->
        <ImageView
            android:id="@+id/widget_lyrics_bg_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- Layer 2: Auto-contrast frosted tint (rgba(18,22,40,.34) or darker) -->
        <FrameLayout
            android:id="@+id/widget_lyrics_bg_tint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#57121628" />

        <!-- Layer 3: Top-left light sheen -->
        <FrameLayout
            android:id="@+id/widget_lyrics_sheen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_sheen_top_left" />

        <!-- Edge: 1dp inner border white 16% + 1dp top highlight white 45% -->
        <FrameLayout
            android:id="@+id/widget_lyrics_card_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_edge_glass_30dp" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/widget_lyrics_empty_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_lyrics_empty_orbi"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_orbi" />

            <ImageView
                android:id="@+id/widget_lyrics_empty_bitmap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_lyrics_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_tap_to_play"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Style 1 Frost Pill Lyrics: 16dp pad, 104dp art (28dp corners, warm rim) left, lyrics column right -->
        <LinearLayout
            android:id="@+id/widget_lyrics_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/widget_lyrics_header_art"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="14dp"
                android:contentDescription="@string/widget_cd_album_art"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <!-- Top Row: Glass Lyrics chip (3-bar eq + "Lyrics") & brand Orbi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/widget_lyrics_chip_container"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="@drawable/widget_frost_chip_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="9dp">

                        <ImageView
                            android:id="@+id/widget_lyrics_eq_bitmap"
                            android:layout_width="14dp"
                            android:layout_height="11dp"
                            android:layout_marginEnd="5dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/widget_lyrics_chip_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/widget_lyrics_tag"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/widget_lyrics_brand_orbi"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:alpha="0.88"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_widget_orbi" />
                </LinearLayout>

                <!-- No-lyrics fallback state -->
                <LinearLayout
                    android:id="@+id/widget_lyrics_no_lyrics_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/widget_lyrics_no_lyrics_label_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyrics_no_lyrics_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_no_lyrics_for_song"
                        android:textColor="#9EFFFFFF"
                        android:textSize="13.5sp" />

                    <ImageView
                        android:id="@+id/widget_lyrics_no_lyrics_title_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyrics_no_lyrics_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#FFFFFF"
                        android:textSize="16.5sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/widget_lyrics_no_lyrics_artist_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyrics_no_lyrics_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#9EFFFFFF"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Synced Lyrics Stage: 4dp gradient bar + 21sp active lyric + static 14sp next lyric -->
                <LinearLayout
                    android:id="@+id/widget_lyrics_stage_row"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_lyrics_accent_bar"
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/widget_gradient_bar_4dp"
                        android:contentDescription="@null"
                        android:minHeight="40dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <ViewFlipper
                            android:id="@+id/widget_lyrics_flipper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:animateFirstView="false"
                            android:autoStart="false"
                            android:inAnimation="@anim/widget_lyric_slide_in"
                            android:outAnimation="@anim/widget_lyric_slide_out">

                            <!-- Slot A -->
                            <FrameLayout
                                android:id="@+id/widget_lyrics_slot_a"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/widget_lyrics_khmer_bitmap_a"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null"
                                    android:scaleType="fitStart"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/widget_lyrics_text_container_a"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/widget_lyrics_current_line_a"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:includeFontPadding="true"
                                        android:lineSpacingExtra="2dp"
                                        android:maxLines="2"
                                        android:textColor="#FFFFFF"
                                        android:textSize="21sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/widget_lyrics_next_line_a"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone" />
                                </LinearLayout>
                            </FrameLayout>

                            <!-- Slot B -->
                            <FrameLayout
                                android:id="@+id/widget_lyrics_slot_b"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/widget_lyrics_khmer_bitmap_b"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null"
                                    android:scaleType="fitStart"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/widget_lyrics_text_container_b"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/widget_lyrics_current_line_b"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:includeFontPadding="true"
                                        android:lineSpacingExtra="2dp"
                                        android:maxLines="2"
                                        android:textColor="#FFFFFF"
                                        android:textSize="21sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/widget_lyrics_next_line_b"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone" />
                                </LinearLayout>
                            </FrameLayout>
                        </ViewFlipper>

                        <!-- Static Next Line OUTSIDE ViewFlipper (14sp, 62% opacity) -->
                        <FrameLayout
                            android:id="@+id/widget_lyrics_next_static_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:id="@+id/widget_lyrics_next_khmer_bitmap"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:adjustViewBounds="true"
                                android:contentDescription="@null"
                                android:scaleType="fitStart"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/widget_lyrics_next_line_static"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:includeFontPadding="true"
                                android:maxLines="1"
                                android:textColor="#9EFFFFFF"
                                android:textSize="14sp"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Bottom Title · Artist Footer -->
                <LinearLayout
                    android:id="@+id/widget_lyrics_footer_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_lyrics_footer_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyrics_song_footer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="true"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
