<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lyrics_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_clip"
    android:clipToOutline="true">

    <!-- Full-bleed blurred & dimmed background bitmap -->
    <ImageView
        android:id="@+id/widget_lyrics_bg_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/widget_lyrics_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_lyrics_empty_orbi"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_orbi" />

        <ImageView
            android:id="@+id/widget_lyrics_empty_bitmap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitStart"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_lyrics_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="@string/widget_open_aurix"
            android:textColor="#FFFFFF"
            android:textSize="15.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Active Lyrics Content: Full-width Header + Balanced Middle Row + Full-width Footer -->
    <LinearLayout
        android:id="@+id/widget_lyrics_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="11dp"
        android:paddingEnd="14dp"
        android:paddingBottom="11dp">

        <!-- Full-Width Top Row: "Lyrics / ទំនុកច្រៀង" Tag Pill on Top-Left + Mini Orbi on Top-Right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_lyrics_tag_container"
                android:layout_width="wrap_content"
                android:layout_height="22dp">

                <ImageView
                    android:id="@+id/widget_lyrics_tag_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="9dp">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_widget_lyrics_wave" />

                    <ImageView
                        android:id="@+id/widget_lyrics_tag_bitmap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyrics_tag_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="@string/widget_lyrics_tag"
                        android:textColor="#ECFAFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_lyrics_brand_orbi"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:alpha="0.90"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_orbi" />
        </LinearLayout>

        <!-- Center Content Row: Styled Side Frame (Optional) + Active & Upcoming Lyrics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_lyrics_frame_spacer"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <!-- No-lyrics song state: title and artist only -->
                <LinearLayout
                    android:id="@+id/widget_lyrics_no_lyrics_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/widget_lyrics_no_lyrics_title_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyrics_no_lyrics_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:shadowColor="#66000000"
                        android:shadowDy="1.5"
                        android:shadowRadius="4"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/widget_lyrics_no_lyrics_artist_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyrics_no_lyrics_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#C2D8EEFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Center Stage: Active Lyric Row (animated) + Static Upcoming Lyric Row (never animated) -->
                <LinearLayout
                    android:id="@+id/widget_lyrics_stage_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/widget_lyrics_accent_bar"
                            android:layout_width="3.5dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/widget_lyric_accent_bar"
                            android:contentDescription="@null" />

                        <ViewFlipper
                            android:id="@+id/widget_lyrics_flipper"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:animateFirstView="false"
                            android:autoStart="false"
                            android:inAnimation="@anim/widget_lyric_slide_in"
                            android:outAnimation="@anim/widget_lyric_slide_out">

                            <!-- Slot A (Active line ONLY) -->
                            <FrameLayout
                                android:id="@+id/widget_lyrics_slot_a"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/widget_lyrics_khmer_bitmap_a"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null"
                                    android:scaleType="fitStart"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/widget_lyrics_text_container_a"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/widget_lyrics_current_line_a"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:includeFontPadding="true"
                                        android:lineSpacingExtra="2dp"
                                        android:lineSpacingMultiplier="1.08"
                                        android:maxLines="2"
                                        android:shadowColor="#66000000"
                                        android:shadowDy="1.5"
                                        android:shadowRadius="4"
                                        android:textColor="#FFFFFF"
                                        android:textSize="16.5sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/widget_lyrics_next_line_a"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone" />
                                </LinearLayout>
                            </FrameLayout>

                            <!-- Slot B (Active line ONLY) -->
                            <FrameLayout
                                android:id="@+id/widget_lyrics_slot_b"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/widget_lyrics_khmer_bitmap_b"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null"
                                    android:scaleType="fitStart"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/widget_lyrics_text_container_b"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/widget_lyrics_current_line_b"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:includeFontPadding="true"
                                        android:lineSpacingExtra="2dp"
                                        android:lineSpacingMultiplier="1.08"
                                        android:maxLines="2"
                                        android:shadowColor="#66000000"
                                        android:shadowDy="1.5"
                                        android:shadowRadius="4"
                                        android:textColor="#FFFFFF"
                                        android:textSize="16.5sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/widget_lyrics_next_line_b"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone" />
                                </LinearLayout>
                            </FrameLayout>
                        </ViewFlipper>
                    </LinearLayout>

                    <!-- Static Upcoming Lyric Line (OUTSIDE ViewFlipper so upcoming lyrics NEVER animate early) -->
                    <FrameLayout
                        android:id="@+id/widget_lyrics_next_static_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13.5dp"
                        android:layout_marginTop="4dp">

                        <ImageView
                            android:id="@+id/widget_lyrics_next_khmer_bitmap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:scaleType="fitStart"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/widget_lyrics_next_line_static"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="true"
                            android:lineSpacingExtra="1.5dp"
                            android:maxLines="1"
                            android:textColor="#B8DCEEFF"
                            android:textSize="12.5sp"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Full-Width Bottom Song Footer (Dangrek for Khmer title + equal-sized English) -->
        <LinearLayout
            android:id="@+id/widget_lyrics_footer_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_lyrics_mini_art"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="7dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/widget_lyrics_footer_bitmap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_lyrics_song_footer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#C2D8EEFF"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtle 1dp glass card border overlay -->
    <ImageView
        android:id="@+id/widget_lyrics_card_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_border_dark"
        android:contentDescription="@null" />
</FrameLayout>
