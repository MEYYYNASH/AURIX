<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clip_28dp"
    android:clipToOutline="true">

    <!-- Low-opacity ambient album glow behind Glass surface -->
    <ImageView
        android:id="@+id/widget_music_bg_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.32"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Glass panel: rgba(14,18,17,.78) + 1dp border rgba(255,255,255,.10), 28dp corners -->
    <FrameLayout
        android:id="@+id/widget_music_card_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_music_glass_bg" />

    <!-- Empty state: Planet logo + "Tap to play music" -->
    <LinearLayout
        android:id="@+id/widget_music_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_music_empty_orbi"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_orbi" />

        <ImageView
            android:id="@+id/widget_music_empty_bitmap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitStart"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_music_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_tap_to_play"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Active Music Content: 16dp padding -->
    <LinearLayout
        android:id="@+id/widget_music_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top section: 64dp art (24% corners) + 17sp title / 13sp 58% artist + 4dp progress bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_music_album_art"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/widget_cd_album_art"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:id="@+id/widget_music_meta_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_music_title_bitmap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_music_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="true"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/widget_music_brand_orbi"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:alpha="0.82"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_widget_orbi" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_music_artist_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitStart"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_music_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#94FFFFFF"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/widget_music_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_bar_glass" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom controls row: >=44dp tap targets, 52dp mint circle play button -->
        <LinearLayout
            android:id="@+id/widget_music_controls_row"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_btn_prev"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="44dp"
                android:minHeight="44dp">

                <ImageView
                    android:id="@+id/widget_btn_prev_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_cd_prev"
                    android:src="@drawable/ic_widget_prev" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/widget_circle_mint">

                <ImageView
                    android:id="@+id/widget_btn_play_pause_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_cd_play_pause"
                    android:src="@drawable/ic_widget_play" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_btn_next"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="44dp"
                android:minHeight="44dp">

                <ImageView
                    android:id="@+id/widget_btn_next_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_cd_next"
                    android:src="@drawable/ic_widget_next" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_btn_like"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="44dp"
                android:minHeight="44dp">

                <ImageView
                    android:id="@+id/widget_btn_like_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_cd_like"
                    android:src="@drawable/ic_widget_heart_outline" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
