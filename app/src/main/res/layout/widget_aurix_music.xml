<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_clip"
    android:clipToOutline="true">

    <!-- Pre-rendered blurred & dimmed ambient album glow or solid card background -->
    <ImageView
        android:id="@+id/widget_music_bg_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Empty state: Orbi icon and "Open AURIX" -->
    <LinearLayout
        android:id="@+id/widget_music_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_music_empty_orbi"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_orbi" />

        <ImageView
            android:id="@+id/widget_music_empty_bitmap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitStart"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_music_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="@string/widget_open_aurix"
            android:textColor="#FFFFFF"
            android:textSize="15.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Active Music Player Content -->
    <LinearLayout
        android:id="@+id/widget_music_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingTop="13dp"
        android:paddingEnd="15dp"
        android:paddingBottom="13dp">

        <!-- Top section: Crisp rounded album art + Dangrek/Outfit Title, Artist & glowing progress bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_music_album_art"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:contentDescription="@string/widget_cd_album_art"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:id="@+id/widget_music_meta_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_music_title_bitmap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_music_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="true"
                        android:maxLines="1"
                        android:shadowColor="#66000000"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/widget_music_brand_orbi"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:alpha="0.88"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_widget_orbi" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_music_artist_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitStart"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_music_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#C2D4EDFF"
                    android:textSize="12.5sp" />

                <ProgressBar
                    android:id="@+id/widget_music_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_bar" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom section: Sculpted translucent glass controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Prev Button -->
            <FrameLayout
                android:id="@+id/widget_btn_prev"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_btn_prev_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/widget_btn_prev_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_cd_prev"
                    android:src="@drawable/ic_widget_prev" />
            </FrameLayout>

            <!-- Play / Pause Button -->
            <FrameLayout
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.32">

                <ImageView
                    android:id="@+id/widget_btn_play_pause_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/widget_btn_play_pause_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_cd_play_pause"
                    android:src="@drawable/ic_widget_play" />
            </FrameLayout>

            <!-- Next Button -->
            <FrameLayout
                android:id="@+id/widget_btn_next"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_btn_next_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/widget_btn_next_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_cd_next"
                    android:src="@drawable/ic_widget_next" />
            </FrameLayout>

            <!-- Like Button (hidden below 3 cells wide) -->
            <FrameLayout
                android:id="@+id/widget_btn_like"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="0.92">

                <ImageView
                    android:id="@+id/widget_btn_like_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/widget_btn_like_icon"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_cd_like"
                    android:src="@drawable/ic_widget_heart_outline" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Crisp 1dp true-dp specular glass perimeter border -->
    <ImageView
        android:id="@+id/widget_music_card_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_border_dark"
        android:contentDescription="@null" />
</FrameLayout>
