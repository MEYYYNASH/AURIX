<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clip_22dp"
    android:clipToOutline="true">

    <!-- Black #000000 Mono panel with 22dp corners -->
    <FrameLayout
        android:id="@+id/widget_music_card_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_music_mono_bg" />

    <ImageView
        android:id="@+id/widget_music_bg_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.0"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/widget_music_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_music_empty_orbi"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_orbi" />

        <ImageView
            android:id="@+id/widget_music_empty_bitmap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitStart"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_music_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_tap_to_play"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Active Mono Content: one slim row + 3dp progress line along bottom -->
    <FrameLayout
        android:id="@+id/widget_music_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/widget_music_album_art"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/widget_cd_album_art"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:id="@+id/widget_music_meta_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_music_title_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitStart"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_music_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_music_artist_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitStart"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_music_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#94FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_music_brand_orbi"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="10dp"
                android:alpha="0.72"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_orbi"
                android:visibility="gone" />

            <!-- Hidden controls in Mono -->
            <FrameLayout
                android:id="@+id/widget_btn_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/widget_btn_prev_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/widget_cd_prev" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_circle_white">

                <ImageView
                    android:id="@+id/widget_btn_play_pause_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_cd_play_pause"
                    android:src="@drawable/ic_widget_play" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_btn_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/widget_btn_next_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/widget_cd_next" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_btn_like"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/widget_btn_like_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/widget_cd_like" />
            </FrameLayout>
        </LinearLayout>

        <!-- 3dp progress line along the bottom -->
        <ProgressBar
            android:id="@+id/widget_music_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_bar_mono" />
    </FrameLayout>
</FrameLayout>
