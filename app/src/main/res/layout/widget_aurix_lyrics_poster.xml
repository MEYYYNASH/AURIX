<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lyrics_outer_shadow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shadow_soft"
    android:layoutDirection="locale"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/widget_lyrics_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_clip_34dp"
        android:clipToOutline="true">

        <!-- Sharp unblurred cover filling whole widget + bottom dark gradient 45% to 0 -->
        <ImageView
            android:id="@+id/widget_lyrics_bg_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <FrameLayout
            android:id="@+id/widget_lyrics_sheen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_sheen_top_left" />

        <FrameLayout
            android:id="@+id/widget_lyrics_card_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_edge_poster_34dp" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/widget_lyrics_empty_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66121628"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_lyrics_empty_orbi"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_orbi" />

            <ImageView
                android:id="@+id/widget_lyrics_empty_bitmap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_lyrics_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_tap_to_play"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Style 5 Poster Glass Lyrics: 34dp corners, 10dp pad, top glass "Lyrics" pill + subtle header, floating blurred bottom glass panel -->
        <FrameLayout
            android:id="@+id/widget_lyrics_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <!-- Top Row: "Lyrics" glass pill top-left + subtle Title · Artist header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/widget_lyrics_chip_container"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:background="@drawable/widget_poster_lyrics_chip_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:id="@+id/widget_lyrics_eq_bitmap"
                        android:layout_width="14dp"
                        android:layout_height="11dp"
                        android:layout_marginEnd="5dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/widget_lyrics_chip_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/widget_lyrics_tag"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_lyrics_footer_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_lyrics_footer_bitmap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitEnd"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyrics_song_footer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:includeFontPadding="true"
                        android:maxLines="1"
                        android:shadowColor="#99000000"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:singleLine="true"
                        android:textColor="#E6FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Floating Blurred Glass Panel (24dp corners) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/widget_clip_24dp"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/widget_lyrics_poster_panel_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="11dp">

                    <!-- No-lyrics fallback -->
                    <LinearLayout
                        android:id="@+id/widget_lyrics_no_lyrics_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/widget_lyrics_no_lyrics_label_bitmap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:scaleType="fitStart"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/widget_lyrics_no_lyrics_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/widget_no_lyrics_for_song"
                            android:textColor="#B3FFFFFF"
                            android:textSize="12.5sp" />

                        <ImageView
                            android:id="@+id/widget_lyrics_no_lyrics_title_bitmap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:scaleType="fitStart"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/widget_lyrics_no_lyrics_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Synced stage inside floating glass panel -->
                    <LinearLayout
                        android:id="@+id/widget_lyrics_stage_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ViewFlipper
                            android:id="@+id/widget_lyrics_flipper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:animateFirstView="false"
                            android:autoStart="false"
                            android:inAnimation="@anim/widget_lyric_slide_in"
                            android:outAnimation="@anim/widget_lyric_slide_out">

                            <FrameLayout
                                android:id="@+id/widget_lyrics_slot_a"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/widget_lyrics_khmer_bitmap_a"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null"
                                    android:scaleType="fitStart"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/widget_lyrics_text_container_a"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/widget_lyrics_current_line_a"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:includeFontPadding="true"
                                        android:lineSpacingExtra="2dp"
                                        android:maxLines="2"
                                        android:textColor="#FFFFFF"
                                        android:textSize="19sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/widget_lyrics_next_line_a"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone" />
                                </LinearLayout>
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/widget_lyrics_slot_b"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/widget_lyrics_khmer_bitmap_b"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null"
                                    android:scaleType="fitStart"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/widget_lyrics_text_container_b"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/widget_lyrics_current_line_b"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:includeFontPadding="true"
                                        android:lineSpacingExtra="2dp"
                                        android:maxLines="2"
                                        android:textColor="#FFFFFF"
                                        android:textSize="19sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/widget_lyrics_next_line_b"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone" />
                                </LinearLayout>
                            </FrameLayout>
                        </ViewFlipper>

                        <!-- Static Next Line OUTSIDE ViewFlipper (13sp, 70% opacity) -->
                        <FrameLayout
                            android:id="@+id/widget_lyrics_next_static_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp">

                            <ImageView
                                android:id="@+id/widget_lyrics_next_khmer_bitmap"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:adjustViewBounds="true"
                                android:contentDescription="@null"
                                android:scaleType="fitStart"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/widget_lyrics_next_line_static"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:includeFontPadding="true"
                                android:maxLines="1"
                                android:textColor="#B3FFFFFF"
                                android:textSize="13sp"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
