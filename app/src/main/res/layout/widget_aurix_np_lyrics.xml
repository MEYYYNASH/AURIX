<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_np_outer_shadow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">

    <FrameLayout
        android:id="@+id/widget_np_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_clip_28dp"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_np_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/widget_np_empty_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_np_empty_orbi"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_orbi" />

            <ImageView
                android:id="@+id/widget_np_empty_bitmap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_np_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_tap_to_play"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lyrics Tall 4x2+ Content -->
        <LinearLayout
            android:id="@+id/widget_np_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <!-- Header row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_np_art"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:contentDescription="@string/widget_cd_album_art"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:id="@+id/widget_np_meta_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/widget_np_title_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_np_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/widget_np_artist_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_np_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#B8FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_np_brand_orbi"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:alpha="0.88"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_orbi" />
            </LinearLayout>

            <!-- Lyrics reading stage -->
            <LinearLayout
                android:id="@+id/widget_np_lyrics_stage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginVertical="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_np_lyric_current_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitStart"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_np_lyric_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.4"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_np_lyric_next_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitStart"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_np_lyric_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.4"
                    android:maxLines="1"
                    android:textColor="#A6FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_np_progress_bitmap"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <LinearLayout
                android:id="@+id/widget_np_controls_row"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/widget_np_btn_prev"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="44dp"
                    android:minHeight="44dp">

                    <ImageView
                        android:id="@+id/widget_np_btn_prev_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/widget_cd_prev"
                        android:src="@drawable/ic_widget_prev" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_np_btn_like"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="44dp"
                    android:minHeight="44dp">

                    <ImageView
                        android:id="@+id/widget_np_btn_like_icon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/widget_cd_like"
                        android:src="@drawable/ic_widget_heart_outline" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_np_btn_play_pause"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="6dp"
                    android:minWidth="44dp"
                    android:minHeight="44dp">

                    <ImageView
                        android:id="@+id/widget_np_btn_play_bg"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_circle_white" />

                    <ImageView
                        android:id="@+id/widget_np_btn_play_pause_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/widget_cd_play_pause"
                        android:src="@drawable/ic_widget_play" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_np_btn_next"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="44dp"
                    android:minHeight="44dp">

                    <ImageView
                        android:id="@+id/widget_np_btn_next_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/widget_cd_next"
                        android:src="@drawable/ic_widget_next" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_np_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_border_28dp" />
    </FrameLayout>
</FrameLayout>
