<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lyrics_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_clip"
    android:clipToOutline="true">

    <!-- Pre-rendered Canvas composite bitmap (large 800x620) -->
    <ImageView
        android:id="@+id/widget_lyrics_bg_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_lyrics_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_lyrics_empty_orbi"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_orbi" />

        <ImageView
            android:id="@+id/widget_lyrics_empty_bitmap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_lyrics_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="@string/widget_open_aurix"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_lyrics_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <!-- Full-Width Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_lyrics_tag_container"
                android:layout_width="wrap_content"
                android:layout_height="24dp">

                <ImageView
                    android:id="@+id/widget_lyrics_tag_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_widget_lyrics_wave" />

                    <ImageView
                        android:id="@+id/widget_lyrics_tag_bitmap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyrics_tag_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="@string/widget_lyrics_tag"
                        android:textColor="#ECFAFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_lyrics_brand_orbi"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:alpha="0.90"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_orbi" />
        </LinearLayout>

        <!-- Balanced Middle Content Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_lyrics_frame_spacer"
                android:layout_width="102dp"
                android:layout_height="102dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="14dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <!-- No-lyrics song state: title and artist only -->
                <LinearLayout
                    android:id="@+id/widget_lyrics_no_lyrics_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/widget_lyrics_no_lyrics_title_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyrics_no_lyrics_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:shadowColor="#66000000"
                        android:shadowDy="1.5"
                        android:shadowRadius="4"
                        android:textColor="#FFFFFF"
                        android:textSize="16.5sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/widget_lyrics_no_lyrics_artist_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyrics_no_lyrics_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#C2D8EEFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Lyrics Stage: Active line animates beside the accent bar, upcoming line stays static below -->
                <LinearLayout
                    android:id="@+id/widget_lyrics_stage_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/widget_lyrics_accent_bar"
                            android:layout_width="3.5dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="11dp"
                            android:background="@drawable/widget_lyric_accent_bar"
                            android:contentDescription="@null" />

                        <ViewFlipper
                            android:id="@+id/widget_lyrics_flipper"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:animateFirstView="false"
                            android:autoStart="false"
                            android:inAnimation="@anim/widget_lyric_slide_in"
                            android:outAnimation="@anim/widget_lyric_slide_out">

                            <FrameLayout
                                android:id="@+id/widget_lyrics_slot_a"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/widget_lyrics_khmer_bitmap_a"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null"
                                    android:scaleType="fitStart"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/widget_lyrics_text_container_a"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/widget_lyrics_current_line_a"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:includeFontPadding="true"
                                        android:lineSpacingExtra="3dp"
                                        android:lineSpacingMultiplier="1.10"
                                        android:maxLines="2"
                                        android:shadowColor="#66000000"
                                        android:shadowDy="1.5"
                                        android:shadowRadius="4"
                                        android:textColor="#FFFFFF"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/widget_lyrics_next_line_a"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone" />
                                </LinearLayout>
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/widget_lyrics_slot_b"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/widget_lyrics_khmer_bitmap_b"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null"
                                    android:scaleType="fitStart"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/widget_lyrics_text_container_b"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/widget_lyrics_current_line_b"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:includeFontPadding="true"
                                        android:lineSpacingExtra="3dp"
                                        android:lineSpacingMultiplier="1.10"
                                        android:maxLines="2"
                                        android:shadowColor="#66000000"
                                        android:shadowDy="1.5"
                                        android:shadowRadius="4"
                                        android:textColor="#FFFFFF"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/widget_lyrics_next_line_b"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone" />
                                </LinearLayout>
                            </FrameLayout>
                        </ViewFlipper>
                    </LinearLayout>

                    <!-- Upcoming / Next lyric line OUTSIDE ViewFlipper: never animated prematurely -->
                    <FrameLayout
                        android:id="@+id/widget_lyrics_next_static_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14.5dp"
                        android:layout_marginTop="5dp">

                        <ImageView
                            android:id="@+id/widget_lyrics_next_khmer_bitmap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:scaleType="fitStart"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/widget_lyrics_next_line_static"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="true"
                            android:lineSpacingExtra="2dp"
                            android:maxLines="1"
                            android:textColor="#B8DCEEFF"
                            android:textSize="12.5sp"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Full-Width Footer Row -->
        <LinearLayout
            android:id="@+id/widget_lyrics_footer_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_lyrics_mini_art"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/widget_lyrics_footer_bitmap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_lyrics_song_footer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#C2D8EEFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_lyrics_card_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_border_dark"
        android:contentDescription="@null" />
</FrameLayout>
