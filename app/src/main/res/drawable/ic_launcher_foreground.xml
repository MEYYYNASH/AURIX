<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft ambient cyan/violet aura behind the 3D orb -->
    <path android:pathData="M54,22 A32,32 0 1,1 53.99,22 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="32">
                <item android:offset="0.0" android:color="#4043C7F4" />
                <item android:offset="0.58" android:color="#1C7965FF" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft floating shadow beneath the 3D sphere -->
    <path android:pathData="M54,75.5 m-20,0 a20,4.5 0 1,0 40,0 a20,4.5 0 1,0 -40,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="75.5"
                android:gradientRadius="20">
                <item android:offset="0.0" android:color="#55000000" />
                <item android:offset="0.6" android:color="#2243C7F4" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tilted -12 deg 3D Onboarding Orbi planet & beveled Saturn ring -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-12">

        <!-- 1. Back half of 3D beveled Saturn ring -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#D92B2E38"
            android:strokeWidth="4.6"
            android:strokeLineCap="round"
            android:pathData="M24.5,54 A29.5,7.8 0 0,1 83.5,54" />
        <path
            android:fillColor="#00000000"
            android:strokeWidth="2.0"
            android:strokeLineCap="round"
            android:pathData="M24.5,54 A29.5,7.8 0 0,1 83.5,54">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="24.5"
                    android:startY="46.2"
                    android:endX="83.5"
                    android:endY="54">
                    <item android:offset="0.0" android:color="#8843C7F4" />
                    <item android:offset="0.5" android:color="#AAFFFFFF" />
                    <item android:offset="1.0" android:color="#887965FF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 2a. 3D Sculpted Porcelain Sphere (top-left studio key light -> cool slate depth) -->
        <path android:pathData="M54,33.5 A20.5,20.5 0 1,1 53.99,33.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="47.0"
                    android:centerY="46.6"
                    android:gradientRadius="30.5">
                    <item android:offset="0.00" android:color="#FFFFFFFF" />
                    <item android:offset="0.42" android:color="#FFF4F7FF" />
                    <item android:offset="0.74" android:color="#FFD2DCEE" />
                    <item android:offset="0.92" android:color="#FF9EAAC2" />
                    <item android:offset="1.00" android:color="#FF7D8AA6" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 2b. Colored neon bounce reflection on bottom-right limb -->
        <path android:pathData="M54,33.5 A20.5,20.5 0 1,1 53.99,33.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="65.5"
                    android:centerY="65.0"
                    android:gradientRadius="19.0">
                    <item android:offset="0.0" android:color="#5543C7F4" />
                    <item android:offset="0.5" android:color="#287965FF" />
                    <item android:offset="1.0" android:color="#00000000" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 2c. Top-left glossy 3D specular highlight dome -->
        <group
            android:pivotX="47"
            android:pivotY="45.2"
            android:rotation="-24">
            <path android:pathData="M47,41.4 A6.6,3.8 0 1,1 46.99,41.4 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="radial"
                        android:centerX="47"
                        android:centerY="45.2"
                        android:gradientRadius="7.2">
                        <item android:offset="0.0" android:color="#F0FFFFFF" />
                        <item android:offset="0.55" android:color="#66FFFFFF" />
                        <item android:offset="1.0" android:color="#00FFFFFF" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <!-- 2d. Subtle Fresnel rim sheen around the 3D sphere -->
        <path
            android:fillColor="#00000000"
            android:strokeWidth="1.05"
            android:pathData="M54,34.1 A19.9,19.9 0 1,1 53.99,34.1 Z">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="34"
                    android:startY="34"
                    android:endX="74"
                    android:endY="74">
                    <item android:offset="0.0" android:color="#B8FFFFFF" />
                    <item android:offset="0.5" android:color="#00FFFFFF" />
                    <item android:offset="1.0" android:color="#7743C7F4" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 2e. Soft cast ring shadow falling onto lower front curve of sphere -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#38151C2E"
            android:strokeWidth="4.0"
            android:strokeLineCap="round"
            android:pathData="M72.6,58.8 A29.5,7.8 0 0,1 35.4,58.8" />

        <!-- 3. Glossy 3D Dark Oval Eyes with dual studio specular catchlights -->
        <path android:pathData="M49.4,45.1 A2.55,4.35 0 1,1 49.39,45.1 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="49.4"
                    android:startY="45.1"
                    android:endX="49.4"
                    android:endY="53.8">
                    <item android:offset="0.0" android:color="#FF252C40" />
                    <item android:offset="1.0" android:color="#FF0B0C10" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:fillColor="#F0FFFFFF"
            android:pathData="M48.6,46.9 A0.98,0.98 0 1,1 48.59,46.9 Z" />
        <path
            android:fillColor="#B843C7F4"
            android:pathData="M50.1,50.5 A0.48,0.48 0 1,1 50.09,50.5 Z" />

        <path android:pathData="M58.6,45.1 A2.55,4.35 0 1,1 58.59,45.1 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="58.6"
                    android:startY="45.1"
                    android:endX="58.6"
                    android:endY="53.8">
                    <item android:offset="0.0" android:color="#FF252C40" />
                    <item android:offset="1.0" android:color="#FF0B0C10" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:fillColor="#F0FFFFFF"
            android:pathData="M57.8,46.9 A0.98,0.98 0 1,1 57.79,46.9 Z" />
        <path
            android:fillColor="#B843C7F4"
            android:pathData="M59.3,50.5 A0.48,0.48 0 1,1 59.29,50.5 Z" />

        <!-- 4. Front half of 3D beveled Saturn ring + neon cyan/violet specular glow -->
        <path
            android:fillColor="#00000000"
            android:strokeWidth="6.8"
            android:strokeLineCap="round"
            android:pathData="M83.5,54 A29.5,7.8 0 0,1 24.5,54">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="24.5"
                    android:startY="54"
                    android:endX="83.5"
                    android:endY="61.8">
                    <item android:offset="0.0" android:color="#3043C7F4" />
                    <item android:offset="0.52" android:color="#40FFFFFF" />
                    <item android:offset="1.0" android:color="#387965FF" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:fillColor="#00000000"
            android:strokeWidth="4.6"
            android:strokeLineCap="round"
            android:pathData="M83.5,54 A29.5,7.8 0 0,1 24.5,54">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="54"
                    android:endX="54"
                    android:endY="62.2">
                    <item android:offset="0.0" android:color="#FF6B7285" />
                    <item android:offset="0.52" android:color="#FF3A3B42" />
                    <item android:offset="1.0" android:color="#FF252832" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:fillColor="#00000000"
            android:strokeWidth="2.1"
            android:strokeLineCap="round"
            android:pathData="M83.5,53.4 A29.5,7.8 0 0,1 24.5,53.4">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="24.5"
                    android:startY="54"
                    android:endX="83.5"
                    android:endY="61.2">
                    <item android:offset="0.0" android:color="#FF43C7F4" />
                    <item android:offset="0.46" android:color="#F5FFFFFF" />
                    <item android:offset="0.82" android:color="#FF7965FF" />
                    <item android:offset="1.0" android:color="#FF43C7F4" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 5. Orbiting glowing 3D moonlet bead with soft neon halo on front-right ring -->
        <path android:pathData="M73.8,53.8 A5.8,5.8 0 1,1 73.79,53.8 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="73.8"
                    android:centerY="59.6"
                    android:gradientRadius="5.8">
                    <item android:offset="0.0" android:color="#9943C7F4" />
                    <item android:offset="0.55" android:color="#3843C7F4" />
                    <item android:offset="1.0" android:color="#0043C7F4" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M73.8,56.8 A2.8,2.8 0 1,1 73.79,56.8 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="73.1"
                    android:centerY="58.9"
                    android:gradientRadius="3.2">
                    <item android:offset="0.0" android:color="#FFFFFFFF" />
                    <item android:offset="0.65" android:color="#FF67E8F9" />
                    <item android:offset="1.0" android:color="#FF43C7F4" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
