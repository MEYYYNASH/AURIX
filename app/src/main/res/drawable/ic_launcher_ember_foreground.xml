<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft ember crimson aura -->
    <path android:pathData="M54,22 A32,32 0 1,1 53.99,22 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="32">
                <item android:offset="0.0" android:color="#42EF4444" />
                <item android:offset="0.6" android:color="#1AFB7185" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-12">

        <!-- Back half of 3D ember ring -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#CC6E171B"
            android:strokeWidth="4.6"
            android:strokeLineCap="round"
            android:pathData="M24.5,54 A29.5,7.8 0 0,1 83.5,54" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#CCEF4444"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:pathData="M24.5,54 A29.5,7.8 0 0,1 83.5,54" />

        <!-- 3D Sculpted Porcelain Sphere with warm crimson depth -->
        <path android:pathData="M54,33.5 A20.5,20.5 0 1,1 53.99,33.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="47.0"
                    android:centerY="46.6"
                    android:gradientRadius="30.5">
                    <item android:offset="0.00" android:color="#FFFFFFFF" />
                    <item android:offset="0.42" android:color="#FFFFF5F5" />
                    <item android:offset="0.74" android:color="#FFEAD6DA" />
                    <item android:offset="0.92" android:color="#FFC19CA4" />
                    <item android:offset="1.00" android:color="#FF9B747E" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Crimson bounce reflection -->
        <path android:pathData="M54,33.5 A20.5,20.5 0 1,1 53.99,33.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="65.5"
                    android:centerY="65.0"
                    android:gradientRadius="19.0">
                    <item android:offset="0.0" android:color="#58EF4444" />
                    <item android:offset="0.55" android:color="#24FB7185" />
                    <item android:offset="1.0" android:color="#00000000" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Specular highlight dome -->
        <group
            android:pivotX="47"
            android:pivotY="45.2"
            android:rotation="-24">
            <path android:pathData="M47,41.4 A6.6,3.8 0 1,1 46.99,41.4 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="radial"
                        android:centerX="47"
                        android:centerY="45.2"
                        android:gradientRadius="7.2">
                        <item android:offset="0.0" android:color="#F0FFFFFF" />
                        <item android:offset="0.55" android:color="#66FFFFFF" />
                        <item android:offset="1.0" android:color="#00FFFFFF" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <!-- Cast ring shadow -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#3B2B0C0F"
            android:strokeWidth="4.0"
            android:strokeLineCap="round"
            android:pathData="M72.6,58.8 A29.5,7.8 0 0,1 35.4,58.8" />

        <!-- Glossy 3D Dark Oval Eyes -->
        <path android:pathData="M49.4,45.1 A2.55,4.35 0 1,1 49.39,45.1 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="49.4"
                    android:startY="45.1"
                    android:endX="49.4"
                    android:endY="53.8">
                    <item android:offset="0.0" android:color="#FF311E24" />
                    <item android:offset="1.0" android:color="#FF0B0C10" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:fillColor="#F0FFFFFF" android:pathData="M48.6,46.9 A0.98,0.98 0 1,1 48.59,46.9 Z" />
        <path android:fillColor="#B8FB7185" android:pathData="M50.1,50.5 A0.48,0.48 0 1,1 50.09,50.5 Z" />

        <path android:pathData="M58.6,45.1 A2.55,4.35 0 1,1 58.59,45.1 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="58.6"
                    android:startY="45.1"
                    android:endX="58.6"
                    android:endY="53.8">
                    <item android:offset="0.0" android:color="#FF311E24" />
                    <item android:offset="1.0" android:color="#FF0B0C10" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:fillColor="#F0FFFFFF" android:pathData="M57.8,46.9 A0.98,0.98 0 1,1 57.79,46.9 Z" />
        <path android:fillColor="#B8FB7185" android:pathData="M59.3,50.5 A0.48,0.48 0 1,1 59.29,50.5 Z" />

        <!-- Front half of glowing 3D beveled ember ring -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#3CEF4444"
            android:strokeWidth="6.8"
            android:strokeLineCap="round"
            android:pathData="M83.5,54 A29.5,7.8 0 0,1 24.5,54" />
        <path
            android:fillColor="#00000000"
            android:strokeWidth="4.4"
            android:strokeLineCap="round"
            android:pathData="M83.5,54 A29.5,7.8 0 0,1 24.5,54">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="24.5"
                    android:startY="54"
                    android:endX="83.5"
                    android:endY="61.8">
                    <item android:offset="0.0" android:color="#FFDC2626" />
                    <item android:offset="0.5" android:color="#FFEF4444" />
                    <item android:offset="1.0" android:color="#FFFB7185" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:fillColor="#00000000"
            android:strokeWidth="1.6"
            android:strokeLineCap="round"
            android:pathData="M83.5,53.4 A29.5,7.8 0 0,1 24.5,53.4">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="24.5"
                    android:startY="53.4"
                    android:endX="83.5"
                    android:endY="60.5">
                    <item android:offset="0.0" android:color="#88FCA5A5" />
                    <item android:offset="0.48" android:color="#F0FFFFFF" />
                    <item android:offset="1.0" android:color="#88FB7185" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Glowing Ember moonlet -->
        <path android:pathData="M73.8,53.8 A5.8,5.8 0 1,1 73.79,53.8 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="73.8"
                    android:centerY="59.6"
                    android:gradientRadius="5.8">
                    <item android:offset="0.0" android:color="#99EF4444" />
                    <item android:offset="0.55" android:color="#38FB7185" />
                    <item android:offset="1.0" android:color="#00000000" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M73.8,56.8 A2.8,2.8 0 1,1 73.79,56.8 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="73.1"
                    android:centerY="58.9"
                    android:gradientRadius="3.2">
                    <item android:offset="0.0" android:color="#FFFFFFFF" />
                    <item android:offset="0.65" android:color="#FFFCA5A5" />
                    <item android:offset="1.0" android:color="#FFEF4444" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
