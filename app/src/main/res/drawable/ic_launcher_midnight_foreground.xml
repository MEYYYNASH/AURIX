<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle soft drop shadow beneath sphere -->
    <path
        android:fillColor="#22000000"
        android:pathData="M54,33.7 A21.9,21.9 0 1,1 53.99,33.7 Z" />

    <!-- Tilted -12 deg geometric planet & orbit group -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-12">

        <!-- Back half of cyan-to-violet gradient orbit ring -->
        <path
            android:fillColor="#00000000"
            android:strokeWidth="3.8"
            android:strokeLineCap="round"
            android:pathData="M24.5,54 A29.5,7.8 0 0,1 83.5,54">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="24.5"
                    android:startY="46.2"
                    android:endX="83.5"
                    android:endY="61.8">
                    <item android:offset="0.0" android:color="#FF5CE6FF" />
                    <item android:offset="0.38" android:color="#FF4F7CFF" />
                    <item android:offset="0.72" android:color="#FF7A5CFF" />
                    <item android:offset="1.0" android:color="#FFA585FF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- White circle character -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M54,33.5 A20.5,20.5 0 1,1 53.99,33.5 Z" />

        <!-- Left black oval eye -->
        <path
            android:fillColor="#FF0B0C10"
            android:pathData="M49.5,44.2 A2.5,4.3 0 1,1 49.49,44.2 Z" />

        <!-- Right black oval eye -->
        <path
            android:fillColor="#FF0B0C10"
            android:pathData="M58.5,44.2 A2.5,4.3 0 1,1 58.49,44.2 Z" />

        <!-- Front half of cyan-to-violet gradient orbit ring -->
        <path
            android:fillColor="#00000000"
            android:strokeWidth="3.8"
            android:strokeLineCap="round"
            android:pathData="M83.5,54 A29.5,7.8 0 0,1 24.5,54">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="24.5"
                    android:startY="46.2"
                    android:endX="83.5"
                    android:endY="61.8">
                    <item android:offset="0.0" android:color="#FF5CE6FF" />
                    <item android:offset="0.38" android:color="#FF4F7CFF" />
                    <item android:offset="0.72" android:color="#FF7A5CFF" />
                    <item android:offset="1.0" android:color="#FFA585FF" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
