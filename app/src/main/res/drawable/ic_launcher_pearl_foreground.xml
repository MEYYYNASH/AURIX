    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-12">

        <!-- Back half of violet orbit ring -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF7C3AED"
            android:strokeWidth="3.8"
            android:strokeLineCap="round"
            android:pathData="M24.5,54 A29.5,7.8 0 0,1 83.5,54" />

        <!-- Lavender planet -->
        <path
            android:pathData="M54,33.5 A20.5,20.5 0 1,1 53.99,33.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="33.5"
                    android:endX="54"
                    android:endY="74.5">
                    <item android:offset="0.0" android:color="#FFFFFFFF" />
                    <item android:offset="0.45" android:color="#FFE6E4FF" />
                    <item android:offset="1.0" android:color="#FFA78BFA" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Left black oval eye -->
        <path
            android:fillColor="#FF141522"
            android:pathData="M49.5,44.2 A2.5,4.3 0 1,1 49.49,44.2 Z" />

        <!-- Right black oval eye -->
        <path
            android:fillColor="#FF141522"
            android:pathData="M58.5,44.2 A2.5,4.3 0 1,1 58.49,44.2 Z" />

        <!-- Front half of violet orbit ring -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF7C3AED"
            android:strokeWidth="3.8"
            android:strokeLineCap="round"
            android:pathData="M83.5,54 A29.5,7.8 0 0,1 24.5,54" />
