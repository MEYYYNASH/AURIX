<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep obsidian onboarding backdrop (#080C14) -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF0E1728" />
                <item android:offset="0.55" android:color="#FF080C14" />
                <item android:offset="1.0" android:color="#FF0B0E1D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top-left neon cyan aurora bloom (#43C7F4) -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="24"
                android:centerY="24"
                android:gradientRadius="68">
                <item android:offset="0.0" android:color="#6643C7F4" />
                <item android:offset="0.45" android:color="#2443C7F4" />
                <item android:offset="1.0" android:color="#0043C7F4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom-right electric violet aurora bloom (#7965FF) -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="84"
                android:centerY="82"
                android:gradientRadius="66">
                <item android:offset="0.0" android:color="#667965FF" />
                <item android:offset="0.48" android:color="#227965FF" />
                <item android:offset="1.0" android:color="#007965FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
