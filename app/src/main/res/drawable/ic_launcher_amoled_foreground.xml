<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-12">

        <!-- Back half of sleek thin white 3D orbit ring -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#CCFFFFFF"
            android:strokeWidth="2.6"
            android:strokeLineCap="round"
            android:pathData="M24.5,54 A29.5,7.8 0 0,1 83.5,54" />

        <!-- 3D Sculpted Monochrome Porcelain Sphere -->
        <path android:pathData="M54,33.5 A20.5,20.5 0 1,1 53.99,33.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="47.0"
                    android:centerY="46.6"
                    android:gradientRadius="30.5">
                    <item android:offset="0.00" android:color="#FFFFFFFF" />
                    <item android:offset="0.48" android:color="#FFF5F5F7" />
                    <item android:offset="0.78" android:color="#FFD4D6DE" />
                    <item android:offset="1.00" android:color="#FF9EA2AE" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Specular highlight dome -->
        <group
            android:pivotX="47"
            android:pivotY="45.2"
            android:rotation="-24">
            <path android:pathData="M47,41.4 A6.6,3.8 0 1,1 46.99,41.4 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="radial"
                        android:centerX="47"
                        android:centerY="45.2"
                        android:gradientRadius="7.2">
                        <item android:offset="0.0" android:color="#F0FFFFFF" />
                        <item android:offset="0.55" android:color="#55FFFFFF" />
                        <item android:offset="1.0" android:color="#00FFFFFF" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <!-- Crisp dark oval eyes with glossy catchlight -->
        <path android:fillColor="#FF000000" android:pathData="M49.4,45.1 A2.55,4.35 0 1,1 49.39,45.1 Z" />
        <path android:fillColor="#F0FFFFFF" android:pathData="M48.6,46.9 A0.96,0.96 0 1,1 48.59,46.9 Z" />

        <path android:fillColor="#FF000000" android:pathData="M58.6,45.1 A2.55,4.35 0 1,1 58.59,45.1 Z" />
        <path android:fillColor="#F0FFFFFF" android:pathData="M57.8,46.9 A0.96,0.96 0 1,1 57.79,46.9 Z" />

        <!-- Crisp black separation channel for high AMOLED contrast -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="5.4"
            android:strokeLineCap="round"
            android:pathData="M83.5,54 A29.5,7.8 0 0,1 24.5,54" />

        <!-- Front half of sleek luminous white ring -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.6"
            android:strokeLineCap="round"
            android:pathData="M83.5,54 A29.5,7.8 0 0,1 24.5,54" />

        <!-- Luminous pure-white moonlet bead -->
        <path android:pathData="M73.8,54.4 A5.2,5.2 0 1,1 73.79,54.4 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="73.8"
                    android:centerY="59.6"
                    android:gradientRadius="5.2">
                    <item android:offset="0.0" android:color="#77FFFFFF" />
                    <item android:offset="1.0" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:fillColor="#FFFFFFFF" android:pathData="M73.8,57.1 A2.5,2.5 0 1,1 73.79,57.1 Z" />
    </group>
</vector>
