<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#8CA06BFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="1dp"
        android:left="26dp"
        android:right="26dp">
        <shape android:shape="rectangle">
            <solid android:color="#73D4B8FF" />
        </shape>
    </item>
</layer-list>
